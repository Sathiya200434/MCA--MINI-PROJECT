# =============================================================================
# Plant Nursery & Gardening Services E-Commerce Platform
# Environment Configuration & MySQL 8.0 Database Credentials
# =============================================================================

# Flask Environment & Security
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=plant-nursery-production-secure-key-2026

# MySQL 8.0 Local Database Credentials
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=Root
MYSQL_DB=plant_nursery

# SQLAlchemy URI (Constructed automatically from above, or overridden here)
DATABASE_URL=mysql+pymysql://root:Root@localhost:3306/plant_nursery?charset=utf8mb4
