# =============================================================================
# Plant Nursery & Gardening Services E-Commerce Platform
# Environment Configuration Template (.env.example)
# Copy this file to .env and configure your local MySQL credentials
# =============================================================================

# Flask Environment & Security
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secure-random-secret-key-here

# MySQL 8.0 Local Database Credentials
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_root_password_here
MYSQL_DB=plant_nursery

# SQLAlchemy URI (Optional; automatically built from above credentials)
DATABASE_URL=mysql+pymysql://root:your_mysql_root_password_here@localhost:3306/plant_nursery?charset=utf8mb4
